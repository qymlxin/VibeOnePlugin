{
  "manifestVersion": 1,
  "id": "dev.vibeone.changes",
  "name": "变更审阅",
  "description": "基于真实 Git 状态的变更树与统一差异审阅插件",
  "author": "VibeOne",
  "version": "0.1.0",
  "engines": {
    "pluginApi": ">=0.1 <0.2"
  },
  "entrypoints": {
    "app": {
      "path": "dist/app.mjs"
    }
  },
  "hostRequirements": [
    "workspace.read"
  ],
  "configSchema": {
    "type": "object",
    "title": "变更审阅首选项",
    "properties": {
      "showTreeByDefault": {
        "type": "boolean",
        "title": "默认显示变更文件列表",
        "default": true
      }
    }
  },
  "contributions": [
    {
      "id": "changes",
      "kind": "app.panel",
      "kindVersion": 1,
      "binding": {
        "type": "app"
      },
      "surface": "workspace.tool",
      "toolId": "changes",
      "title": "变更",
      "description": "变更审阅 · 可独立更新和停用",
      "icon": "changes"
    }
  ]
}
